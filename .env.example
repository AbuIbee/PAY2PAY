# Copy this file to .env.local (or .env.<environment>.local) and fill in
# real values. .env.local is gitignored — never commit real secrets.
#
# See README.md "Environment configuration" for the full explanation of
# each variable and the development/test/staging/production pattern.

# --- Core app config -------------------------------------------------------

# One of: development | test | staging | production
# Distinct from NODE_ENV (which Next.js itself only allows to be
# development/test/production) so a "staging" deployment can be configured
# distinctly at the application-config level.
APP_ENV=development

# --- Database (required) ----------------------------------------------------

# Postgres connection string. Required — the app will refuse to start any
# code path that touches the database without this set.
# No live database is required for Phase 0's own health check or page
# rendering; this is only validated when database-backed code actually runs.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/pay2pay

# --- Audit trail (required) -------------------------------------------------

# Secret pepper mixed into the audit hash chain (src/lib/audit/hash.ts) so
# the chain cannot be recomputed by someone with only database read access.
# Generate a long random value, e.g.: openssl rand -hex 32
AUDIT_HASH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- Auth (required) --------------------------------------------------------

# Secret pepper mixed into every password hash (src/lib/auth/password.ts) so
# a stolen database alone is not enough to offline-brute-force credentials.
# Generate a long random value, e.g.: openssl rand -hex 32
AUTH_PASSWORD_PEPPER=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- Public (client-safe) config --------------------------------------------

# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time — never put a secret here.
NEXT_PUBLIC_APP_NAME=PAY2PAY
NEXT_PUBLIC_APP_ENV=development

# --- Feature flags (optional overrides) -------------------------------------

# Any flag in src/lib/feature-flags.ts can be overridden per-environment
# with FEATURE_<FLAG_NAME_IN_SCREAMING_SNAKE_CASE>=true|false. Example:
# FEATURE_EXAMPLE_FOUNDATION_FLAG=false
