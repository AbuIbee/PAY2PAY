# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets or local overrides;
# .env.example is intentionally re-included below since it must contain
# only placeholders and is required setup documentation.
.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
# PRSprint 04 (docs/prsprints/PRSPRINT_04_SECRETS_ENVIRONMENT_PRODUCTION_SEPARATION.md): the exact-name
# patterns above never matched a suffixed backup/copy variant (e.g. a manually created
# `.env.local.BACKUP`) — closing that gap defensively so any such file can never be accidentally
# staged, regardless of what suffix a human appends to it.
.env.local.*
.env*.backup
.env*.bak
.env*.old
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle-kit generated migrations metadata (SQL migrations themselves are
# committed once Phase 1+ starts generating real ones; nothing generated yet)
/drizzle/meta

# credentials / keys — defense in depth beyond the env rules above
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
